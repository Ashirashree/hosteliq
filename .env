# HostelIQ AI - Environment Configuration

# Gemini API Key (Official Google GenAI SDK)
GEMINI_API_KEY=

# Supabase PostgreSQL & Vector Database Configuration
# (Optional for live mode; if omitted, backend runs with high-fidelity local SQLite & vector cosine search)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
